<mxfile host="app.diagrams.net"><diagram name="C4 Containers PA3" id="pa3"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="boundary" value="Система Valuator — PA3" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;dashed=1;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="150" width="1300" height="700" /></mxCell><mxCell id="user" value="Пользователь&#10;[Person]&#10;Отправляет текст, читает результат" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="10" width="310" height="110" /></mxCell><mxCell id="nginx" value="Nginx&#10;[Container: reverse proxy]&#10;Балансировка HTTP :8080" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="195" width="310" height="100" /></mxCell><mxCell id="web" value="Valuator ×2 (+1)&#10;[Container: ASP.NET Core]&#10;Форма, similarity, ID задания, summary&#10;Порты 5001 / 5002 / 5003" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="365" width="310" height="130" /></mxCell><mxCell id="redis" value="Redis&#10;[Container: key-value database]&#10;Тексты, similarity, rank, outbox" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=15;shape=cylinder;" vertex="1" parent="1"><mxGeometry as="geometry" x="75" y="600" width="300" height="135" /></mxCell><mxCell id="broker" value="RabbitMQ&#10;[Container: message broker]&#10;Durable queue: valuator.processing.rank&#10;Сообщение содержит только ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxG