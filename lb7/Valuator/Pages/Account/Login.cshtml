@page
@model Valuator.Pages.Account.LoginModel
@{ ViewData["Title"] = "Вход"; }
<h1>Вход</h1>
@if (Model.Registered) { <p role="status">Регистрация завершена. Войдите с вашим логином и паролем.</p> }
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="mb-3"><label asp-for="Login">Логин</label><input asp-for="Login" class="form-control" autocomplete="username" maxlength="32" /></div>
    <div class="mb-3"><label asp-for="Password">Пароль</label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password" maxlength="128" /></div>
    <button class="btn btn-primary" type="submit">Войти</button>
</form>
<p><a asp-page="/Account/Register">Создать аккаунт</a></p>
