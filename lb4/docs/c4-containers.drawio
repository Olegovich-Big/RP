<mxfile host="app.diagrams.net"><diagram name="C4 Containers PA4" id="pa4"><mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="boundary" value="Система Valuator — PA4" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;dashed=1;verticalAlign=top;align=left;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="280" width="1540" height="1040" /></mxCell><mxCell id="user" value="Пользователь&#10;[Person]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="10" width="300" height="80" /></mxCell><mxCell id="browser" value="Браузер&#10;[Внешнее клиентское приложение]&#10;HTML-форма / summary" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="140" width="300" height="100" /></mxCell><mxCell id="nginx" value="Nginx&#10;[Container: reverse proxy]&#10;Балансировка HTTP :8080" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="325" width="300" height="100" /></mxCell><mxCell id="web" value="Valuator ×2 (+1)&#10;[Container: ASP.NET Core]&#10;similarity, POST, summary&#10;Публикует SimilarityCalculated" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="505" width="300" height="130" /></mxCell><mxCell id="redis" value="Redis&#10;[Container: key-value database]&#10;Тексты, метрики, outbox" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=15;shape=cylinder;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="505" width="300" height="130" /></mxCell><mxCell id="rank" value="RankCalculator ×N&#10;[Container: .NET Worker]&#10;Вычисляет и сохраняет rank&#10;Публикует RankCalculated" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1150" y="505" width="330" height="130" /></mxCell><mxCell id="mq" value="RabbitMQ&#10;[Container: message broker]&#10;Очередь заданий rank&#10;Fanout exchange: valuator.events&#10;Две независимые очереди логгеров" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="600" y="805" width="300" height="160" /></mxCell><mxCell id="keys" value="Общие ключи защиты форм&#10;[Filesystem / Docker volume]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="100" y="780" width="300" height="100" /></mxCell><mxCell id="logger1" value="EventsLogger #1&#10;[Container: .NET Worker]&#10;Очередь valuator.events.logger1&#10;Оба события → консоль" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="290" y="1130" width="340" height="130" /></mxCell><mxCell id="logger2" value="EventsLogger #2&#10;[Container: .NET Worker]&#10;Очередь valuator.events.logger2&#10;Оба события → консоль" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="1130" width="340" height="130" /></mxCell><mxCell id="e1" value="Ввод текста / просмотр" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="browser"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="HTTP GET / POST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="browser" target="nginx"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="HTTP :5001 / :5002" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nginx" target="web"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="RESP: текст, similarity, outbox; чтение rank" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="redis"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="RESP: чтение текста, rank + outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rank" target="redis"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="AMQP: ID задания + SimilarityCalculated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="mq"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="AMQP: задание одному работнику" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mq" target="rank"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="AMQP: RankCalculated + ack задания" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rank" target="mq"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="AMQP: копия каждого события" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mq" target="logger1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="AMQP: копия каждого события" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mq" target="logger2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="Ключи защиты форм" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="keys"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>